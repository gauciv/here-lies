{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "here-lies-daily",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html",
        "height": "tall"
      },
      "game": {
        "entry": "game.html",
        "height": "tall"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Post today's crossing",
        "description": "Here Lies",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "scheduler": {
    "tasks": {
      "daily-post": {
        "endpoint": "/internal/cron/daily-post",
        "cron": "0 0 * * *"
      }
    }
  },
  "dev": {
    "subreddit": "here_lies_daily_dev"
  },
  "permissions": {
    "redis": true,
    "reddit": {
      "asUser": [
        "SUBMIT_POST",
        "SUBSCRIBE_TO_SUBREDDIT"
      ]
    }
  },
  "marketingAssets": {
    "icon": "assets/icon.png"
  }
}
